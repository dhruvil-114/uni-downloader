{
  "name": "uni-downloader",
  "version": "2.0.0",
  "description": "Uni Downloader - FDM/IDM-style Universal Download Manager for Direct Files (16x), Torrents/Magnets, YouTube, Instagram, Snapchat, TikTok, Dailymotion & 1000+ platforms",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:start": "electron .",
    "start": "electron ."
  },
  "keywords": [
    "youtube-downloader",
    "video-downloader",
    "instagram-downloader",
    "tiktok-downloader",
    "electron",
    "react",
    "yt-dlp",
    "ffmpeg",
    "4k-downloader",
    "mp3-converter"
  ],
  "author": "Dhruvil Panchal",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
